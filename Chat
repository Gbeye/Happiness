<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimal 1-on-1 Chat</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar for chat box */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.25);
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 h-screen flex flex-col justify-center items-center p-2 sm:p-4 selection:bg-indigo-500 selection:text-white">

    <!-- App Container -->
    <div id="app" class="w-full max-w-2xl bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden flex flex-col h-[94vh] sm:h-[88vh]">
        
        <!-- Header -->
        <header class="bg-white border-b border-slate-100 px-5 py-4 flex items-center justify-between z-10 shadow-sm">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold shadow-md shadow-indigo-100">
                    <i class="fa-solid fa-comments text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-slate-800 text-lg leading-tight">Private Chat</h1>
                    <div class="flex items-center space-x-1.5 text-xs text-slate-500">
                        <span id="status-dot" class="w-2 h-2 rounded-full bg-amber-400 inline-block animate-pulse"></span>
                        <span id="status-text">Connecting...</span>
                    </div>
                </div>
            </div>

            <!-- Settings / Config Toggle Button -->
            <button id="config-btn" title="Firebase Settings" class="p-2.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition duration-150 flex items-center justify-center">
                <i class="fa-solid fa-gear text-lg"></i>
            </button>
        </header>

        <!-- Main Viewport (Switchable Screens) -->
        <div class="flex-1 relative overflow-hidden bg-slate-50/50">
            
            <!-- 1. JOIN / SETUP SCREEN -->
            <div id="setup-screen" class="absolute inset-0 z-20 bg-white p-6 overflow-y-auto flex flex-col justify-between">
                <div class="max-w-md mx-auto w-full py-4">
                    <div class="text-center mb-6">
                        <h2 class="text-2xl font-bold text-slate-800">Welcome</h2>
                        <p class="text-slate-500 text-sm mt-1">Enter your details & private room key to start chatting.</p>
                    </div>

                    <!-- User Form -->
                    <form id="join-form" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Your Name</label>
                            <input type="text" id="input-username" required placeholder="e.g. Alex" 
                                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition text-sm">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Room ID / Secret Passcode</label>
                            <div class="relative">
                                <input type="text" id="input-room" required placeholder="e.g. secret-chat-123" 
                                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition text-sm font-mono">
                                <button type="button" id="gen-room-btn" class="absolute right-2 top-2 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-medium transition">
                                    Random
                                </button>
                            </div>
                            <p class="text-xs text-slate-400 mt-1">Share this exact Room ID with your partner.</p>
                        </div>

                        <button type="submit" 
                            class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 transition duration-150 transform active:scale-[0.99] text-sm mt-2">
                            Enter Chat Room
                        </button>
                    </form>

                    <!-- Deployment Info Banner -->
                    <div class="mt-8 p-4 bg-indigo-50/70 rounded-xl border border-indigo-100 text-xs text-indigo-900 leading-relaxed">
                        <div class="font-semibold flex items-center mb-1 text-indigo-700">
                            <i class="fa-solid fa-cloud-arrow-up mr-2 text-sm"></i> Host for Free
                        </div>
                        Push this single <code class="bg-indigo-100 px-1 py-0.5 rounded text-indigo-800">index.html</code> file to a <b>GitHub Repository</b> and enable <b>GitHub Pages</b>, or deploy directly with <b>Firebase Hosting</b>!
                    </div>
                </div>

                <div class="text-center text-xs text-slate-400 pt-4">
                    Minimalist 1-on-1 Web Chat App
                </div>
            </div>

            <!-- 2. FIREBASE CONFIG MODAL (OVERLAY) -->
            <div id="config-modal" class="hidden absolute inset-0 z-30 bg-slate-900/40 backdrop-blur-sm p-4 flex items-center justify-center">
                <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl border border-slate-100 p-6 space-y-4 max-h-[90vh] overflow-y-auto">
                    <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                        <h3 class="font-bold text-slate-800 text-base">Custom Firebase Settings</h3>
                        <button id="close-config-btn" class="text-slate-400 hover:text-slate-600 p-1">
                            <i class="fa-solid fa-xmark text-lg"></i>
                        </button>
                    </div>
                    <p class="text-xs text-slate-500">
                        By default, this app uses a built-in Firebase sandbox instance. You can paste your own Firebase Web Config JSON below to use your own database project.
                    </p>
                    
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Firebase Config JSON</label>
                        <textarea id="config-json-input" rows="6" placeholder='{
  "apiKey": "AIzaSy...",
  "authDomain": "app.firebaseapp.com",
  "projectId": "app-id",
  "storageBucket": "app.appspot.com",
  "messagingSenderId": "...",
  "appId": "..."
}' class="w-full font-mono text-xs p-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-slate-50"></textarea>
                    </div>

                    <div class="flex space-x-2 pt-2">
                        <button id="save-config-btn" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs rounded-xl transition">
                            Apply Custom Config
                        </button>
                        <button id="reset-config-btn" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium text-xs rounded-xl transition">
                            Reset Default
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3. CHAT MESSAGES CONTAINER -->
            <div id="chat-screen" class="h-full flex flex-col">
                <!-- Room info bar -->
                <div class="bg-white/80 backdrop-blur border-b border-slate-100 px-5 py-2 flex items-center justify-between text-xs text-slate-500">
                    <div class="flex items-center space-x-2">
                        <span class="font-medium text-slate-400">Room:</span>
                        <span id="display-room" class="font-mono bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-semibold"></span>
                    </div>
                    <button id="leave-room-btn" class="text-xs text-slate-400 hover:text-rose-600 transition flex items-center">
                        <i class="fa-solid fa-right-from-bracket mr-1"></i> Leave Room
                    </button>
                </div>

                <!-- Messages Scroll Area -->
                <div id="messages-container" class="flex-1 overflow-y-auto p-4 space-y-3.5">
                    <!-- Dynamic Messages will load here -->
                    <div id="empty-state" class="h-full flex flex-col items-center justify-center text-center p-6 text-slate-400">
                        <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mb-3 text-slate-300">
                            <i class="fa-regular fa-paper-plane text-xl"></i>
                        </div>
                        <p class="text-sm font-medium text-slate-500">No messages yet</p>
                        <p class="text-xs text-slate-400 mt-1 max-w-xs">Send a message or invite your friend using this room code to start chatting!</p>
                    </div>
                </div>

                <!-- Input Footer -->
                <div class="bg-white border-t border-slate-100 p-3 sm:p-4">
                    <form id="send-form" class="flex items-center space-x-2">
                        <input type="text" id="input-message" autocomplete="off" placeholder="Type your message..." 
                            class="flex-1 bg-slate-50 border border-slate-200 text-slate-800 placeholder-slate-400 text-sm rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
                        <button type="submit" id="send-btn" disabled 
                            class="bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:hover:bg-indigo-600 text-white p-3 rounded-xl transition duration-150 flex items-center justify-center shadow-md shadow-indigo-100 w-11 h-11 flex-shrink-0">
                            <i class="fa-solid fa-paper-plane text-sm"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Firebase Modular SDK Imports -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { 
            getFirestore, 
            collection, 
            addDoc, 
            onSnapshot, 
            serverTimestamp 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global Variables Provided by Environment Fallback
        const defaultAppId = typeof __app_id !== 'undefined' ? __app_id : 'minimal-chat-app';
        const defaultFirebaseConfig = typeof __firebase_config !== 'undefined' 
            ? JSON.parse(__firebase_config) 
            : {
                apiKey: "demo-api-key",
                authDomain: "demo-project.firebaseapp.com",
                projectId: "demo-project",
                storageBucket: "demo-project.appspot.com",
                messagingSenderId: "123456789",
                appId: "1:123456789:web:demo"
            };

        // Application State
        let app, auth, db;
        let currentUser = null;
        let currentRoomId = "";
        let username = "";
        let unsubscribeMessages = null;

        // UI Element References
        const statusDot = document.getElementById('status-dot');
        const statusText = document.getElementById('status-text');
        const setupScreen = document.getElementById('setup-screen');
        const configModal = document.getElementById('config-modal');
        const configBtn = document.getElementById('config-btn');
        const closeConfigBtn = document.getElementById('close-config-btn');
        const configJsonInput = document.getElementById('config-json-input');
        const saveConfigBtn = document.getElementById('save-config-btn');
        const resetConfigBtn = document.getElementById('reset-config-btn');
        const joinForm = document.getElementById('join-form');
        const inputUsername = document.getElementById('input-username');
        const inputRoom = document.getElementById('input-room');
        const genRoomBtn = document.getElementById('gen-room-btn');
        const displayRoom = document.getElementById('display-room');
        const leaveRoomBtn = document.getElementById('leave-room-btn');
        const messagesContainer = document.getElementById('messages-container');
        const emptyState = document.getElementById('empty-state');
        const sendForm = document.getElementById('send-form');
        const inputMessage = document.getElementById('input-message');
        const sendBtn = document.getElementById('send-btn');

        // Initialize Firebase
        function initFirebase(config) {
            try {
                app = initializeApp(config);
                auth = getAuth(app);
                db = getFirestore(app);

                // Authenticate anonymously
                const initialToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                
                onAuthStateChanged(auth, (user) => {
                    if (user) {
                        currentUser = user;
                        updateStatus(true, "Connected");
                    } else {
                        updateStatus(false, "Signing in...");
                        signInAnonymously(auth).catch((err) => {
                            console.error("Auth failed:", err);
                            updateStatus(false, "Auth Error");
                        });
                    }
                });
            } catch (err) {
                console.error("Firebase init failed:", err);
                updateStatus(false, "Config Error");
            }
        }

        // Helper to update online status UI
        function updateStatus(isOnline, text) {
            statusText.textContent = text;
            if (isOnline) {
                statusDot.className = "w-2 h-2 rounded-full bg-emerald-500 inline-block";
            } else {
                statusDot.className = "w-2 h-2 rounded-full bg-amber-400 inline-block animate-pulse";
            }
        }

        // Random Room Generator
        genRoomBtn.addEventListener('click', () => {
            const randomCode = Math.random().toString(36).substring(2, 8);
            inputRoom.value = `chat-${randomCode}`;
        });

        // Config Modal Toggles
        configBtn.addEventListener('click', () => {
            configModal.classList.remove('hidden');
        });
        closeConfigBtn.addEventListener('click', () => {
            configModal.classList.add('hidden');
        });

        saveConfigBtn.addEventListener('click', () => {
            try {
                const customConfig = JSON.parse(configJsonInput.value.trim());
                initFirebase(customConfig);
                configModal.classList.add('hidden');
            } catch (e) {
                alert("Invalid JSON format. Please check your Firebase configuration string.");
            }
        });

        resetConfigBtn.addEventListener('click', () => {
            configJsonInput.value = "";
            initFirebase(defaultFirebaseConfig);
            configModal.classList.add('hidden');
        });

        // Enable/Disable Send Button
        inputMessage.addEventListener('input', () => {
            sendBtn.disabled = !inputMessage.value.trim();
        });

        // Join Room Action
        joinForm.addEventListener('submit', (e) => {
            e.preventDefault();
            username = inputUsername.value.trim();
            currentRoomId = inputRoom.value.trim().toLowerCase();

            if (!username || !currentRoomId) return;

            displayRoom.textContent = currentRoomId;
            setupScreen.classList.add('hidden');
            
            // Listen to messages in this room
            subscribeToRoom(currentRoomId);
        });

        // Leave Room Action
        leaveRoomBtn.addEventListener('click', () => {
            if (unsubscribeMessages) unsubscribeMessages();
            setupScreen.classList.remove('hidden');
            messagesContainer.innerHTML = '';
            messagesContainer.appendChild(emptyState);
            emptyState.classList.remove('hidden');
        });

        // Subscribe to Firestore Messages for the room
        function subscribeToRoom(roomId) {
            if (!currentUser) return;

            // MANDATORY RULE: Use correct path structure for public room data
            const messagesRef = collection(db, 'artifacts', defaultAppId, 'public', 'data', `room_${roomId}`);

            // MANDATORY RULE: No complex orderBy queries without explicit indexes.
            // We fetch all records in collection and sort in JavaScript memory.
            unsubscribeMessages = onSnapshot(messagesRef, (snapshot) => {
                const rawDocs = [];
                snapshot.forEach(doc => {
                    rawDocs.push({ id: doc.id, ...doc.data() });
                });

                // Sort in memory by timestamp
                rawDocs.sort((a, b) => {
                    const timeA = a.createdAt?.seconds || 0;
                    const timeB = b.createdAt?.seconds || 0;
                    return timeA - timeB;
                });

                renderMessages(rawDocs);
            }, (error) => {
                console.error("Error reading room messages:", error);
            });
        }

        // Render Message Bubbles
        function renderMessages(messages) {
            messagesContainer.innerHTML = '';

            if (messages.length === 0) {
                messagesContainer.appendChild(emptyState);
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            messages.forEach((msg) => {
                const isMe = msg.userId === currentUser?.uid || msg.username === username;
                
                const wrapper = document.createElement('div');
                wrapper.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} mb-1`;

                const timeStr = msg.createdAt?.seconds 
                    ? new Date(msg.createdAt.seconds * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                    : 'just now';

                wrapper.innerHTML = `
                    <div class="text-[10px] text-slate-400 font-medium mb-1 px-1">
                        ${isMe ? 'You' : escapeHtml(msg.username || 'Friend')}
                    </div>
                    <div class="max-w-[82%] sm:max-w-[70%] px-4 py-2.5 rounded-2xl text-sm ${
                        isMe 
                            ? 'bg-indigo-600 text-white rounded-br-none shadow-sm' 
                            : 'bg-white text-slate-800 border border-slate-200/80 rounded-bl-none shadow-sm'
                    }">
                        <p class="leading-relaxed break-words">${escapeHtml(msg.text)}</p>
                    </div>
                    <span class="text-[9px] text-slate-400 mt-1 px-1">${timeStr}</span>
                `;

                messagesContainer.appendChild(wrapper);
            });

            // Scroll to bottom
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // Send Message
        sendForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = inputMessage.value.trim();
            if (!text || !currentUser || !currentRoomId) return;

            inputMessage.value = '';
            sendBtn.disabled = true;

            try {
                // MANDATORY RULE: Strictly use `/artifacts/{appId}/public/data/{collectionName}`
                const messagesRef = collection(db, 'artifacts', defaultAppId, 'public', 'data', `room_${currentRoomId}`);
                
                await addDoc(messagesRef, {
                    text: text,
                    username: username,
                    userId: currentUser.uid,
                    createdAt: serverTimestamp()
                });
            } catch (err) {
                console.error("Error sending message:", err);
            }
        });

        // XSS Prevention Utility
        function escapeHtml(str) {
            return String(str || '').replace(/[&<>"']/g, (m) => {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[m];
            });
        }

        // Initialize Firebase on load
        window.addEventListener('DOMContentLoaded', () => {
            initFirebase(defaultFirebaseConfig);
        });
    </script>
</body>
</html>
